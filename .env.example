# Resend（お問い合わせフォームのメール送信）
# https://resend.com でアカウント作成 → API Keys → Create API Key
NUXT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# フォーム送信先メールアドレス（店舗のメールアドレス）
NUXT_CONTACT_EMAIL=info@your-shop.com

# 送信元メールアドレス（Resendで認証済みドメインのアドレス）
# 未設定の場合は noreply@resend.dev になります（テスト用）
# 本番環境では認証済みドメインのアドレスを設定してください
NUXT_CONTACT_FROM_EMAIL=noreply@your-shop.com

# CSRF暗号化シークレット（nuxt-csurf が使用・生成: openssl rand -hex 32）
# 未設定だとCSRF検証が弱くなるため必ず設定すること
NUXT_CSRF_SECRET=

# サイトURL（canonical URL・sitemap.xml に使用）
# 末尾スラッシュなし
NUXT_PUBLIC_SITE_URL=https://your-shop.com

# Google Analytics 4 測定ID（任意）
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# microCMS（ニュース自動更新。任意）
# NUXT_MICROCMS_API_KEY=
# NUXT_PUBLIC_MICROCMS_SERVICE_DOMAIN=
